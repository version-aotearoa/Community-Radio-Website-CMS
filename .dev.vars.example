# Local-only Cloudflare bindings and secrets (never commit real values)
# Copy to .dev.vars for local `vite dev` / `wrangler` runs.

# Better Auth
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Resend (transactional email for magic links). With the key present in
# .dev.vars, local dev sends real links; without it, links log to the console.
RESEND_API_KEY=
RESEND_FROM=Version Radio <noreply@versionradio.live>

# Contact form recipient (fallback: EMAIL_FROM, then admin@versionradio.live)
CONTACT_TO=

# OAuth providers (optional until configured)
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# AzuraCast (server-only). Used by /api/replay-waveform to fetch real waveform
# peaks from the station's media library. Requires station media access.
AZURACAST_API_KEY=

# Chat worker public URL (local: http://localhost:8790)
PUBLIC_CHAT_URL=http://localhost:8790

# Giphy GIF search (client-side key; beta keys ~100 calls/hr). Create at
# https://developers.giphy.com/dashboard/ and set on Pages projects too.
PUBLIC_GIPHY_API_KEY=

# Cloudflare Turnstile — TEST keys (always pass). Replace before production.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,example.com
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

CHAT_IDENTITY_SECRET=

CHAT_ADMIN_TOKEN=
